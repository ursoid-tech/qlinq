#!/usr/bin/env python3
"""Run one frozen reliable candidate case; never interpret it as full qualification."""
import argparse
import hashlib
import json
from pathlib import Path
import shlex
import subprocess

ROOT = Path(__file__).resolve().parents[1]
PROFILE = ROOT / 'examples/profiles/reliable-current-api-v1.json'


def command(profile, args):
    options = dict(profile['common'], **profile['cases'][args.case])
    options.update(seed=args.seed, **{'fault-path': args.fault_path,
        'fault-direction': args.fault_direction, 'sender-cpu': args.sender_cpu,
        'receiver-cpu': args.receiver_cpu, 'router-cpus': args.router_cpus,
        'receive-delivery': getattr(args, 'receive_delivery', 'queue'),
        'send-batch': getattr(args, 'send_batch', None),
        'output-dir': str(Path(args.output_dir).resolve())})
    argv = [str(ROOT / 'examples/multipath_transit_demo')]
    for key, value in options.items():
        if value is True:
            argv.append('--' + key)
        elif value is not None and value is not False:
            argv += ['--' + key, str(value)]
    return argv


def main():
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument('--profile', type=Path, default=PROFILE,
                   help='profile JSON; defaults to the frozen current reliable candidate')
    p.add_argument('--case', required=True)
    p.add_argument('--seed', type=int, required=True)
    p.add_argument('--fault-path', type=int, choices=range(3), default=0)
    p.add_argument('--fault-direction', choices=['forward', 'reverse', 'both'], default='forward')
    p.add_argument('--sender-cpu', type=int, required=True)
    p.add_argument('--receiver-cpu', type=int, required=True)
    p.add_argument('--receive-delivery', choices=['queue', 'callback'], default='queue',
                   help='receiver record bridge; queue is the frozen-profile default')
    p.add_argument('--send-batch', type=int, choices=range(1, 4097),
                   help='benchmark records submitted after each service call; default 32')
    p.add_argument('--router-cpus', metavar='FORWARD,REVERSE,...',
                   help='one shared pair or three forward/reverse pairs, in path order; requires root')
    p.add_argument('--output-dir', required=True)
    p.add_argument('--print-command', action='store_true', help='print the command without running or writing files')
    args = p.parse_args()
    profile_path = args.profile.resolve()
    profile_bytes = profile_path.read_bytes()
    profile = json.loads(profile_bytes)
    if args.case not in profile['cases']:
        p.error(f'case must be one of: {", ".join(profile["cases"])}')
    if not 1 <= args.seed <= 0xffffffff:
        p.error('seed must be in [1,4294967295]')
    if args.fault_direction == 'reverse' and 'recovery-mbps' in profile['cases'][args.case]:
        p.error('this case requires restored forward capacity; reverse-only feedback recovery needs a separate case')
    argv = command(profile, args)
    if args.print_command:
        print(shlex.join(argv))
        return 0
    out = Path(args.output_dir).resolve()
    if out.exists():
        p.error('output-dir must be new; prior evidence is never overwritten')
    out.mkdir(parents=True)
    (out / 'qualification-profile.json').write_text(json.dumps({
        'profile': profile, 'profile_sha256': hashlib.sha256(profile_bytes).hexdigest(),
        'profile_path': str(profile_path),
        'runner_sha256': hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
        'command': argv,
        'note': 'Candidate case only. Original report gates remain authoritative; full qualification requires the remaining matrix and physical hosts.'
    }, indent=2) + '\n')
    return subprocess.run(argv, cwd=ROOT).returncode


if __name__ == '__main__':
    raise SystemExit(main())
